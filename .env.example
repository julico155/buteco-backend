# Postgres propio del backend central: solo hace falta la cadena de conexión
# (cualquier proveedor), con credenciales propias.
DATABASE_URL=postgres://user:password@host:5432/backend_central

# Nombre del negocio (título de Swagger en /docs). Default "Backend central".
APP_NAME=

PORT=3000

# Orígenes permitidos por CORS, separados por coma. Necesario para cualquier
# front en el navegador (POS, dashboard); los clientes que no son navegadores
# (gateway de WhatsApp, Postman) no lo necesitan. Vacío = ningún origen.
CORS_ORIGINS=http://localhost:5173

# Tokens estáticos por servicio cliente (bearer, comparación timing-safe).
# Cada api_client autorizado a llamar a este backend tiene su propio token.
# Formato: <api_client>:<token>,<api_client>:<token>,...
# Un token por cliente de servicio; el nombre decide el canal de sus pedidos: whatsapp-gateway = whatsapp, web = web, external = external (POS ajeno).
# No definas uno llamado "pos": el POS usa JWT de staff, nunca un token de servicio.
SERVICE_AUTH_TOKENS=whatsapp-gateway:changeme

# Cliente HTTP hacia el "gateway API" de mensajería (avisos salientes).
GATEWAY_BASE_URL=http://localhost:4000
GATEWAY_AUTH_TOKEN=changeme

# JWT de sesión de staff (dashboard_users) — distinto del bearer estático
# entre servicios. Generar con: openssl rand -base64 48
JWT_SECRET=changeme
JWT_EXPIRES_IN=8h

# Distancia real de calle para delivery (Mapbox Directions API). Vacío =
# DeliveryModule usa línea recta (haversine) automáticamente, sin tocar
# código. Crear en https://account.mapbox.com/access-tokens/.
MAPBOX_ACCESS_TOKEN=

# Storage de objetos — hoy, las fotos de producto (S3 o S3-compatible:
# Cloudflare R2, MinIO, etc.). Vacío (sin bucket) = disco local
# automáticamente, sin tocar código; en un host efímero se pierde en cada
# deploy, así que en producción conviene configurarlo. Dejar
# STORAGE_S3_ENDPOINT vacío para AWS S3; setearlo para cualquier otro
# proveedor S3-compatible (en R2, es
# https://<account_id>.r2.cloudflarestorage.com).
# Los nombres anteriores PAYMENT_PROOFS_S3_* se siguen aceptando si no
# están estos.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=

# API QR de Banco Económico (cobro real). Certificación:
# https://apimktdesa.baneco.com.bo/ApiGateway/ — ver
# el manual de integración de la API QR del banco para el resto de las
# credenciales (usuario/password/AES key/cuenta las entrega el banco, nunca
# van en este archivo ni en el repo).
BANECO_BASE_URL=
BANECO_USERNAME=
BANECO_PASSWORD=
BANECO_AES_KEY=
BANECO_ACCOUNT=

# 'manual' = mientras el banco no habilite producción del QR: el POS ya no
# puede pedir un QR real (POST /orders/:id/qr/generate da 409
# qr_manual_mode), el cajero confirma el cobro a mano con
# POST /orders/:id/payment-attempts/confirm-presencial. Solo afecta
# channel='pos' — WhatsApp no se toca. Vacío o cualquier otro valor = modo
# normal (QR real de Baneco). Sacar esta variable del entorno de despliegue apenas el
# banco dé el ok a producción.
POS_QR_MODE=

# Minutos tras los que un pedido sin pagar (WhatsApp o POS) se cancela solo. Default 20.
UNPAID_ORDER_TTL_MINUTES=
# Minutos que una solicitud fuera de horario espera la decisión del staff antes de
# vencer. Vacío = el mismo valor que UNPAID_ORDER_TTL_MINUTES.
LATE_ORDER_REQUEST_TTL_MINUTES=
# Destino (chat/grupo) del aviso a repartidores; lo resuelve el gateway de
# mensajería. Default "delivery-group".
DELIVERY_NOTICE_CHAT_REF=

# Radio en metros alrededor del local dentro del cual un repartidor puede aceptar un pedido. Default 150.
DELIVERY_ACCEPT_RADIUS_METERS=

# Radio en metros entre dos pedidos DISPONIBLES (todavía sin aceptar) para
# reportarlos como cercanos entre sí en GET /delivery/orders/available — nunca
# se expone la ubicación cruda del cliente antes de aceptar. Default 500.
DELIVERY_NEARBY_RADIUS_METERS=

# Primer admin SIN terminal ni acceso a la base (despliegues automáticos): si
# BOOTSTRAP_ADMIN_PASSWORD está definida (mínimo 8 caracteres) y todavía no
# existe ningún admin, la app lo crea al arrancar. Con un admin existente no
# hace nada. Una vez creado, quitá la contraseña del entorno. El usuario por
# defecto es "admin".
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Teléfonos separados por coma que saltan el gate de horario SOLO para
# channel='web' (pensado para probar el checkout fuera de horario sin abrir
# al público). No es un flag del cliente: se resuelve server-side contra el
# teléfono real del customerId. No cambia business_opens_hour/closesHour ni
# el gate de caja para pagar. Vacío = sin bypass (default, comportamiento
# normal). TEMPORAL: sacar esta variable del entorno de despliegue cuando termine la prueba.
AI_TEST_PHONES=
